# Copy to .env locally. Never commit real credentials.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
TIMEZONE=Europe/Madrid

POSTGRES_DB=videofactory
POSTGRES_USER=videofactory
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://videofactory:change-this-local-password@localhost:5433/videofactory

MEDIA_ROOT=./data
MAX_UPLOAD_GB=20

COMFYUI_BASE_URL=http://127.0.0.1:8188
N8N_BASE_URL=http://127.0.0.1:5678
BLENDER_BIN=blender
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Optional external providers; leave empty for local-only mode.
VIDEO_PROVIDER_API_KEY=
LLM_API_KEY=
TTS_API_KEY=
